{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction",
  "description": "A card transaction event published to the `transactions` topic.",
  "type": "object",
  "required": [
    "event_id", "event_type", "timestamp", "customer_id", "account_id",
    "card_id", "amount", "currency", "merchant_id", "merchant_category",
    "channel"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "const": "transaction"},
    "timestamp": {"type": "string", "format": "date-time"},
    "customer_id": {"type": "string"},
    "account_id": {"type": "string"},
    "card_id": {"type": "string"},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "merchant_id": {"type": "string"},
    "merchant_category": {"type": "string"},
    "channel": {"type": "string", "enum": ["card_present", "online"]},
    "device_id": {"type": ["string", "null"]},
    "location": {
      "type": "object",
      "properties": {
        "city": {"type": "string"},
        "country": {"type": "string"},
        "lat": {"type": "number"},
        "lon": {"type": "number"}
      }
    }
  }
}
