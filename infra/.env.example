# Copy to infra/.env and fill in real values. Never commit infra/.env.

# --- Kafka / Confluent Cloud ---
# Local fallback default; replace with your Confluent Cloud bootstrap server once provisioned.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Set to SASL_SSL and fill the two values above when pointing at Confluent Cloud.

# --- Topics ---
TOPIC_TRANSACTIONS=transactions
TOPIC_LOGIN_EVENTS=login-events
TOPIC_FRAUD_ALERTS=fraud-alerts
TOPIC_CASE_ACTIONS=case-actions

# --- Alert/Case API ---
ALERT_API_HOST=0.0.0.0
ALERT_API_PORT=8000
ALERT_API_DB_URL=sqlite:///./alerts.db
# Kafka consumer group id the alert API uses to read fraud-alerts. Change
# this only if you want a fresh replay from the beginning of the topic
# (a new group.id always starts from auto.offset.reset=earliest); reusing
# the same value resumes from committed offsets as normal.
ALERT_API_CONSUMER_GROUP=alert-api

# --- watsonx Orchestrate ---
WXO_ENV_URL=
WXO_API_KEY=
# Base URL Orchestrate should use to reach the alert API. During local dev this
# must be a public tunnel (e.g. ngrok), not localhost, unless Orchestrate runs
# in the same network as the API.
WXO_ALERT_API_BASE_URL=

# --- General ---
LOG_LEVEL=INFO
ENVIRONMENT=local
